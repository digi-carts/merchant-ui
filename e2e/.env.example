# E2E Environment Variables
# Copy this to .env.test.local and fill in values

# Application URL
BASE_URL=http://localhost:3000

# Backend API URL
API_URL=http://localhost:8080/v1

# Test merchant account credentials (must already exist in the DB)
TEST_EMAIL=test@merchant.com
TEST_PASSWORD=Test@1234

# Optional: separate account that hasn't completed setup (for setup wizard tests)
TEST_SETUP_EMAIL=setup@merchant.com
TEST_SETUP_PASSWORD=Test@1234
